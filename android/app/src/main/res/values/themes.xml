<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose paints everything, so this exists only to give the window a
        background before the first frame. Without it the window flashes the
        platform default, which is white even in dark mode.
    -->
    <style name="Theme.Sonduit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
