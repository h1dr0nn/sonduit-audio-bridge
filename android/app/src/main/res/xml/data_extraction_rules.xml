<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up or transferred. The app holds no user data: no
    accounts, no library, no history. Excluding everything is simpler to reason
    about than listing what happens to exist today.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
