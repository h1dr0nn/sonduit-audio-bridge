<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages this app ships. Declaring them puts Sonduit in Android's
    per-app language screen, so someone whose phone is in one language can read
    the app in another without changing the whole device.

    Without this the app silently follows the system language and there is no
    way to override it, which is exactly the complaint that prompted this.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="vi" />
    <locale android:name="de" />
    <locale android:name="es" />
    <locale android:name="fr" />
    <locale android:name="it" />
    <locale android:name="pt" />
    <locale android:name="ru" />
    <locale android:name="ja" />
    <locale android:name="ko" />
    <locale android:name="zh" />
</locale-config>
